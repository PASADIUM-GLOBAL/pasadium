# PASADIUM Production Topology Blueprint
# ============================================================
# This file defines the canonical production architecture.
# Local development should use a separate .env file.

# Environment
APP_ENV=production
DOMAIN=pasadium.tech

# Public API Boundary
# Frontends consume this stable contract. Internal engines remain hidden.
NEXT_PUBLIC_API_URL=https://api.pasadium.tech/api
NEXT_PUBLIC_AUTH_URL=https://auth.pasadium.tech

# Public Surface Map (For OAuth callbacks, redirects, and cross-surface linking)
WEB_URL=https://pasadium.tech
ADMIN_URL=https://admin.pasadium.tech
TRADE_URL=https://trade.pasadium.tech
MARKET_URL=https://market.pasadium.tech
MEDIA_URL=https://media.pasadium.tech
DOCS_URL=https://docs.pasadium.tech

# Backend Infrastructure (Private Network Layer)
# These should never be exposed to the public internet.
DATABASE_URL="postgresql://user:password@db.pasadium.tech:5432/pasadium"
REDIS_URL="redis://redis.pasadium.tech:6379"
OBJECT_STORAGE_ENDPOINT="https://s3.pasadium.tech"

# Security & Identity
JWT_SECRET=your_production_secure_jwt_secret_here
DEV_SEED_PASSWORD=your_secure_production_seed_password

# OAuth / OIDC Configuration
AUTH_CLIENT_ID=web-gateway
AUTH_CLIENT_SECRET=your_production_client_secret
